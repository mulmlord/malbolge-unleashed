; Adder: reads two 3-digit decimal numbers separated by one byte (e.g. "123 456" or "123+456";
; anything after the second number is ignored) and prints their sum in decimal, without leading
; zeros, and a newline: "123 456" prints 579, "999 999" prints 1998, "000 000" prints 0.
; Any other input is undefined behaviour; EOF before the sixth digit halts without output.
;
; Column sums. Each column (H, T, O) has a 4-cycle and a 5-cycle counter (MovD/Nop x3,
; MovD/Nop x4); a digit d passes them d mod 4 and d mod 5 times, so the pair holds the column sum
; a + b (+ carry) mod 20 (Chinese remainder theorem; at most 19).
;
; Reading a counter: a k-cycle that was passed s times fires on pass 1 when s = 0 mod k, on pass 2
; when s = k-1, ..., so `Q L0 Q L3 Q L2 Q L1` branches on s mod 4; afterwards the counter has
; passed s + (number of passes) = 1 mod k times. The ones and tens columns are read, then the
; digit is added back (phase 1 + digit) for printing; the carry goes on to the next column. The
; hundreds column is printed directly from its 20 branches.
;
; Digits are branched on as in digital_root.mua: DISP crazies the byte into X, jumps through X
; into SLED and lands on a table entry per digit. The stub of digit d picks the column body
; (flags FH, FT, otherwise O); the body passes the column's counters d times, sets the column's
; return flag and resets X to 0t1..1 (RST_d); the return flag then continues the input sequence.
; ALT tells the first number's ones digit from the second's.

.CODE
IN:     In/Nop
        Jmp

OUT:    Out/Nop
        Jmp

ROT:    Rot/Nop
        Jmp

OPR:    Opr/Nop
        Jmp

MOVED:  MovD/Nop
        Jmp

NOP:    Jmp

HALT:   Hlt

FH:     Nop/MovD                ; the digit is a hundreds digit
        Jmp

FT:     Nop/MovD                ; the digit is a tens digit
        Jmp

RH:     Nop/MovD                ; return from a reset pass of DISP (hundreds digit)
        Jmp

RT:     Nop/MovD                ; ... tens digit
        Jmp

RO:     Nop/MovD                ; ... ones digit
        Jmp

ALT:    Nop/MovD                ; toggles: second visit = second number done
        Jmp

LEAD:   Nop/MovD                ; set: no digit printed yet
        Jmp

QH4:    MovD/Nop/Nop/Nop        ; column H, mod 4
        Jmp

QH5:    MovD/Nop/Nop/Nop/Nop    ; column H, mod 5
        Jmp

QT4:    MovD/Nop/Nop/Nop        ; column T, mod 4
        Jmp

QT5:    MovD/Nop/Nop/Nop/Nop    ; column T, mod 5
        Jmp

QO4:    MovD/Nop/Nop/Nop        ; column O, mod 4
        Jmp

QO5:    MovD/Nop/Nop/Nop/Nop    ; column O, mod 5
        Jmp

@1t0201 {
SLED:   RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop RNop
        RNop RNop RNop RNop RNop RNop RNop
        Jmp
}

; EOF lands at 3^12, above the program text; its 12 RNops select the first table entry.
@531441 {
EOFL:   RNop RNop RNop RNop RNop RNop RNop RNop RNop RNop RNop RNop
        Jmp
}

.DATA
{
ENTRY:  R_MOVED                 ; disarm MOVED: READ re-arms it
READ:   R_MOVED
        R_FH IN ?- R_IN MOVED DISP      ; hundreds digit
RETH:   R_FT IN ?- R_IN MOVED DISP      ; tens digit
RETT:   IN ?- R_IN MOVED DISP           ; ones digit
RETO:   ALT SUM
        IN ?- R_IN                      ; the separator
        MOVED READ
DISP:   R_MOVED
        OPR X: 0t111111111111
        R_OPR
        RH RETH R_RH
        RT RETT R_RT
        RO RETO R_RO
        MOVED X                 ; jump through X; entry j is read after j RNops
        U_NOP STOP   ; EOF
        U_NOP D8     ; '8'
        U_NOP D6     ; '6'
        U_NOP D7     ; '7'
        ?-   ; unused
        U_NOP D9     ; '9'
        ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?-   ; unused
        ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?- ?-
        ?- ?- ?- ?- ?-
        U_NOP D5     ; '5'
        U_NOP D3     ; '3'
        U_NOP D4     ; '4'
        ?- ?- ?-   ; unused
        U_NOP D2     ; '2'
        U_NOP D0     ; '0'
        U_NOP D1     ; '1'

D0:     R_MOVED FH BH0 R_FH FT BT0 R_FT MOVED BO0
D1:     R_MOVED FH BH1 R_FH FT BT1 R_FT MOVED BO1
D2:     R_MOVED FH BH2 R_FH FT BT2 R_FT MOVED BO2
D3:     R_MOVED FH BH3 R_FH FT BT3 R_FT MOVED BO3
D4:     R_MOVED FH BH4 R_FH FT BT4 R_FT MOVED BO4
D5:     R_MOVED FH BH5 R_FH FT BT5 R_FT MOVED BO5
D6:     R_MOVED FH BH6 R_FH FT BT6 R_FT MOVED BO6
D7:     R_MOVED FH BH7 R_FH FT BT7 R_FT MOVED BO7
D8:     R_MOVED FH BH8 R_FH FT BT8 R_FT MOVED BO8
D9:     R_MOVED FH BH9 R_FH FT BT9 R_FT MOVED BO9
STOP:   HALT
}

