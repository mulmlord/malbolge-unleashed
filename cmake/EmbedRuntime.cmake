# cmake -DRUNTIME_DIR=<rv/runtime> -DOUTPUT=<file.cpp> -P EmbedRuntime.cmake
# Writes a C++ source that defines malm::runtime_files() (src/driver/runtime_files.hpp): the RISC-V
# runtime's crt0, linker script, headers and libc sources, the Rust and Zig runtimes and the Lua
# script's wrapper, as byte arrays, so that `malm build` needs nothing but the malm binary and a
# compiler.
file(GLOB headers RELATIVE "${RUNTIME_DIR}" "${RUNTIME_DIR}/include/*.h")
file(GLOB sources RELATIVE "${RUNTIME_DIR}" "${RUNTIME_DIR}/src/*.c")
file(GLOB rust RELATIVE "${RUNTIME_DIR}" "${RUNTIME_DIR}/rust/*.rs")
file(GLOB zig RELATIVE "${RUNTIME_DIR}" "${RUNTIME_DIR}/zig/*.zig")
list(SORT headers)
list(SORT sources)
list(SORT rust)
list(SORT zig)
set(files crt0.S link.ld ${headers} ${sources} ${rust} ${zig} lua/script.S)

set(arrays "")
set(entries "")
set(i 0)
foreach(file IN LISTS files)
    file(READ "${RUNTIME_DIR}/${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND arrays "const unsigned char f${i}[] = {\n    ${bytes}};\n")
    string(APPEND entries "    {\"${file}\", f${i}, sizeof f${i}},\n")
    math(EXPR i "${i} + 1")
endforeach()

file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT [=[
// Generated by cmake/EmbedRuntime.cmake from rv/runtime; do not edit.
#include "driver/runtime_files.hpp"

namespace malm {
namespace {

@arrays@
struct Entry {
    const char* path;
    const unsigned char* bytes;
    std::size_t size;
};

const Entry kEntries[] = {
@entries@};

} // namespace

std::vector<RuntimeFile> runtime_files() {
    std::vector<RuntimeFile> files;
    for (const Entry& e : kEntries) {
        files.push_back({e.path, std::string_view(reinterpret_cast<const char*>(e.bytes), e.size)});
    }
    return files;
}

} // namespace malm
]=])
